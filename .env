# Public contact details surfaced in the site (safe to commit — no secrets).
# Local overrides go in .env.local (git-ignored).
NEXT_PUBLIC_CONTACT_PHONE=15-6151-2447
NEXT_PUBLIC_CONTACT_TEL=+5491161512447
NEXT_PUBLIC_CONTACT_WHATSAPP=5491161512447
NEXT_PUBLIC_CONTACT_ADDRESS=Av. Gaspar Campos 4848, José C. Paz, Buenos Aires

# --- SEO / production domain ---
# Canonical host: `www`, https, NO trailing slash (metadataBase and the JSON-LD @id
# append their own path — a trailing slash here produces `//` in canonical/og:url).
# Must be set identically in Vercel (Production + Preview) and match the link
# published in the Google Business Profile.
NEXT_PUBLIC_SITE_URL=https://www.cocherianoguesymartinez.com

# --- Structured address (for JSON-LD PostalAddress) ---
# Complements NEXT_PUBLIC_CONTACT_ADDRESS (free-form string shown in the UI).
NEXT_PUBLIC_CONTACT_LOCALITY=José C. Paz
NEXT_PUBLIC_CONTACT_REGION=Buenos Aires
